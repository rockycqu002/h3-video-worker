{
  "unet":    {"class_type": "UNETLoader", "inputs": {"unet_name": "DasiwaMinimaxH3_dasiwaHybrid8turboV1.safetensors", "weight_dtype": "default"}},
  "shift":   {"class_type": "MiniMaxH3SigmaShift", "inputs": {"model": ["unet", 0], "shift_video": 9.0, "shift_audio": 4.0}},
  "clip":    {"class_type": "CLIPLoader", "inputs": {"clip_name": "qwen3vl_32b_minimax_h3_nvfp4_awq.safetensors", "type": "minimax", "device": "default"}},
  "vae_v":   {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_video_vae_fp16.safetensors"}},
  "vae_a":   {"class_type": "VAELoader", "inputs": {"vae_name": "minimax_h3_audio_vae_fp32.safetensors"}},
  "cond":    {"class_type": "MiniMaxH3ImageToVideo", "inputs": {"clip": ["clip", 0], "vae": ["vae_v", 0], "prompt": "PROMPT", "width": 1344, "height": 768, "length": 124}},
  "guider":  {"class_type": "BasicGuider", "inputs": {"model": ["shift", 0], "conditioning": ["cond", 0]}},
  "sampler": {"class_type": "KSamplerSelect", "inputs": {"sampler_name": "euler"}},
